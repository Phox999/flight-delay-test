{
  "name": "flight-delay-usability-test",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "FLOW_URL": "/flow/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flight-delay-usability",
      "database_id": "請替換成你的 D1 database_id"
    }
  ]
}
