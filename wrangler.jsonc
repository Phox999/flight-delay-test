{
  "name": "flight-delay-test",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "FLOW_URL": "/flow/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flight-delay-usability",
      "database_id": "392eb8bd-326a-4981-8774-38c07df77aa7"
    }
  ]
}
